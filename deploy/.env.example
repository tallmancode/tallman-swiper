# Copy to the VPS next to docker-compose.yml as `.env` (never commit real values).
# Full aaPanel / VPS runbook: docs/deploy-vps.md
GHCR_OWNER=your-github-user-or-org
IMAGE_TAG=v0.0.1

# Host port aaPanel reverse-proxies to (Compose maps this → app container PORT).
HOST_PORT=8080

# Container listen port (must match Dockerfile EXPOSE / healthcheck).
PORT=3000

# Required: Pexels API key for /api/photos (server-side only).
PEXELS_API_KEY=change-me-pexels-api-key

# Optional: baked into the SPA at image build time (CI passes these as build-args).
# Leave empty on the VPS unless you build images locally with compose.
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENV=production
