{
  "name": "tallman-swiper",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx server/index.ts",
    "build": "vue-tsc && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "start": "node server-dist/index.js",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "audit:ci": "npm audit --audit-level=high",
    "checks": "npm run typecheck && npm run build && npm run build:server && npm run audit:ci"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@sentry/vue": "^10.74.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pexels": "^1.4.0",
    "vite-plugin-commonjs": "^0.10.4",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^6.0.9",
    "tsx": "^4.23.13",
    "typescript": "^5.0.2",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
